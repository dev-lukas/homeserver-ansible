[Unit]
Description=Periodically wake the CI Runner VM so GitHub runner registrations stay alive

[Timer]
# Fixed schedule so the gap never approaches GitHub's ~14-day registration expiry;
# Persistent catches up a run missed while the host was down.
OnCalendar={{ ci_runner_keepalive_oncalendar }}
Persistent=true
AccuracySec=1h
Unit=ci-runner-keepalive.service

[Install]
WantedBy=timers.target
