# {{ ansible_managed }}
[Unit]
Description=CNCF Distribution container registry
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ registry_lxc_user }}
Group={{ registry_lxc_user }}
ExecStart=/usr/local/bin/registry serve /etc/registry/config.yml
Restart=on-failure
RestartSec=5

# Sandbox: the service only ever needs to read /etc/registry and write the
# data directory. Strictly stronger than the docker flags it replaces.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths={{ registry_lxc_data_mp }}
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
MemoryMax=384M

[Install]
WantedBy=multi-user.target
